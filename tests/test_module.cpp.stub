#include "Config.h"
#include "DBCStores.h"
#include "DatabaseEnv.h"
#include "ObjectMgr.h"
#include "Player.h"
#include "ScriptMgr.h"
#include "World.h"
#include <cassert>
#include <iostream>
#include <vector>

ConfigMgr* ConfigMgr::instance() { static ConfigMgr config; return &config; }
std::vector<PlayerScript*> PlayerScript::all;
std::vector<WorldScript*> WorldScript::all;
GlyphStore sGlyphPropertiesStore;
ObjectMgr objMgr;
ObjectMgr* sObjectMgr = &objMgr;
World world;
World* sWorld = &world;
DatabaseStub WorldDatabase;
void Addmod_bonus_talent_pointsScripts();

uint32 Allowed(uint32 level, uint8 cl = 1, uint32 map = 0) {
    Player player(level, cl, map);
    uint32 points = level < 10 ? 0 : level - 9;
    for (auto script : PlayerScript::all) script->OnPlayerCalculateTalentsPoints(&player, points);
    return points;
}
void Login(Player* p) { for (auto script : PlayerScript::all) script->OnPlayerLogin(p); }
void Level(Player* p) { for (auto script : PlayerScript::all) script->OnPlayerLevelChanged(p, uint8(p->GetLevel()-1)); }
void Spec(Player* p) { for (auto script : PlayerScript::all) script->OnPlayerAfterSpecSlotChanged(p, 1); }
void Load() { for (auto script : WorldScript::all) script->OnAfterConfigLoad(false); }
int main() {
    objMgr.rows.emplace(0,GossipMenuItems{0,16,18,10000000});
    objMgr.rows.emplace(42,GossipMenuItems{42,7,18,5000000});
    Addmod_bonus_talent_pointsScripts();
    assert(PlayerScript::all.size()==2 && WorldScript::all.size()==3);
    Load();
    for (auto script : WorldScript::all) script->OnStartup();
    struct Expected { uint32 level, count; } expected[] = {
        {1,0},{9,0},{10,1},{14,5},{15,7},{16,8},
        {20,13},{25,19},{30,25},{35,31},{40,37},
        {45,43},{50,49},{55,55},{60,61},{61,62},
        {70,71},{80,81}
    };
    for (auto const& item : expected) assert(Allowed(item.level) == item.count);
    assert(Allowed(55,CLASS_DEATH_KNIGHT,609) == 46);
    assert(Allowed(55,CLASS_DEATH_KNIGHT,0) == 55);
    Player dk(60, CLASS_DEATH_KNIGHT, 609);
    Login(&dk); dk.SetMapId(0);
    for(auto script : PlayerScript::all) script->OnPlayerMapChanged(&dk);
    assert(dk.recalculations == 2);

    Player p(30);
    Login(&p);
    assert(p.glyphMask == 0x0B); // bits 0,1,3
    p.SetLevel(80); Level(&p);
    assert(p.glyphMask == 0x3F);
    p.glyphs[5] = 123;
    p.SetLevel(60); Spec(&p);
    assert(p.glyphs[5] == 0 && p.glyphSaveCalls == 1);
    assert(p.removedAuras.size()==1 && p.removedAuras[0] == 4567);

    assert(sWorld->minimumDualSpecLevel == 40);
    assert(objMgr.rows.equal_range(0).first->second.BoxMoney == 10000000);
    sConfigMgr->options["DualSpec.MinLevel"] = "25";
    sConfigMgr->options["DualSpec.CostGold"] = "250";
    sConfigMgr->options["GlyphUnlocks.Major3.Level"] = "60";
    Load();
    assert(sWorld->minimumDualSpecLevel == 25);
    assert(objMgr.rows.equal_range(0).first->second.BoxMoney == 2500000);
    assert(objMgr.rows.equal_range(42).first->second.BoxMoney == 2500000);
    Login(&p);
    assert(p.glyphMask == 0x2F); // Major3 at 60, Minor3 still at 70
    sConfigMgr->options["DualSpec.Enable"] = "0";
    Load();
    assert(objMgr.rows.equal_range(0).first->second.BoxMoney == 10000000);
    assert(objMgr.rows.equal_range(42).first->second.BoxMoney == 5000000);
    std::cout << "PASS: bonus talents, DK, glyph masks/cleanup, dual spec price and level, reload/restore\n";
}
